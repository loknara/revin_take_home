# Non-secret ID of the existing Summit Air voice baseline assistant.
VAPI_ASSISTANT_ID=c1d4d1d8-b2e4-48b9-9ffe-ca4bbea2dd43
# Set a random shared secret of at least 32 characters, not your Vapi API key.
VAPI_WEBHOOK_SECRET=
# Supabase project URL and backend-only secret (or legacy service_role key).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Local administration / paid simulation only.
VAPI_API_KEY=
# Local opt-in database transaction tests / Supabase CLI only.
SUPABASE_DB_PASSWORD=

# --- Hosting from this Mac (scripts/serve-local) ---
# Your free static ngrok domain (dashboard.ngrok.com > Domains), without https://.
NGROK_DOMAIN=
# Default --backend-url for configure_vapi, e.g. https://<NGROK_DOMAIN>.
BACKEND_URL=

# --- Dispatcher alerts (priority/emergency/callback requests) ---
# Long random topic; anyone who knows it can read alerts. Subscribe in the ntfy phone app.
# Alerts never include caller name, address or phone number.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
# Optional access token for a protected/self-hosted ntfy topic.
NTFY_TOKEN=

# --- Talking to a person ---
# Live transfer destination (E.164). Used only by configure_vapi to build the Vapi
# transferCall tool and by the backend to tell the agent a transfer exists. Never commit it.
TRANSFER_NUMBER=
# When the office is open (America/New_York). Outside these hours the agent offers a
# callback request instead of a transfer, except to the on-call line for priority calls.
OFFICE_HOURS="mon-fri 08:00-18:00"

# Operational weather priority thresholds, not medical safety limits.
WEATHER_HOT_F=90
WEATHER_COLD_F=40

# Serve /evaluation/* simulation endpoints (paid Vapi evals only). Keep off for the phone line.
ENABLE_EVALUATION_API=0

# --- Parked: SMS/email appointment confirmations (tools/optional/) ---
# The agent does not offer confirmations until real delivery is configured and the
# optional tools are attached. Kept for later; safe to leave blank.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
RESEND_API_KEY=
CONFIRMATION_FROM_EMAIL=
CONFIRMATION_DELIVERY_MODE=stub
