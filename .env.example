# Non-secret ID of the existing Summit Air voice baseline assistant.
VAPI_ASSISTANT_ID=c1d4d1d8-b2e4-48b9-9ffe-ca4bbea2dd43
# Set a random shared secret of at least 32 characters, not your Vapi API key.
VAPI_WEBHOOK_SECRET=
# Supabase project URL and backend-only secret (or legacy service_role key).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Local administration / paid simulation only; not needed on Render.
VAPI_API_KEY=
# Local opt-in database transaction tests / Supabase CLI only.
SUPABASE_DB_PASSWORD=

# Operational weather priority thresholds, not medical safety limits.
WEATHER_HOT_F=90
WEATHER_COLD_F=40

# Optional transactional SMS sender (separate from the Vapi inbound number).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Optional transactional email sender: verified Resend sending domain/address.
RESEND_API_KEY=
CONFIRMATION_FROM_EMAIL=
