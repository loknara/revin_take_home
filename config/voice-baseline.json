{
  "model": {
    "provider": "openai",
    "model": "gpt-4.1",
    "promptCacheRetention": "24h"
  },
  "transcriber": {
    "provider": "soniox",
    "model": "stt-rt-v6",
    "language": "en",
    "languages": ["en"],
    "endpointLatencyAdjustmentLevel": 1,
    "endpointSensitivity": 0,
    "maxEndpointDelayMs": 1500,
    "customVocabulary": [
      "Summit Air",
      "HVAC",
      "furnace",
      "boiler",
      "radiator",
      "heat pump",
      "mini split",
      "condenser",
      "thermostat",
      "carbon monoxide",
      "Astoria",
      "Jackson Heights",
      "Elmhurst",
      "Flushing",
      "Forest Hills",
      "Rego Park",
      "Woodside",
      "Sunnyside",
      "Long Island City",
      "Bayside",
      "Little Neck",
      "Ridgewood",
      "Bushwick",
      "Bed-Stuy",
      "Park Slope",
      "Williamsburg"
    ],
    "contextGeneral": [
      {"key": "domain", "value": "Residential heating and air-conditioning service calls"},
      {"key": "location", "value": "New York City: Manhattan, Brooklyn and Queens"},
      {"key": "address_format", "value": "Queens house numbers are hyphenated, for example 35-20 82nd Street or 104-15 Queens Boulevard"},
      {"key": "phone_format", "value": "US phone numbers read in groups, for example 212-555-0188"}
    ],
    "fallbackPlan": {"autoFallback": {"enabled": true}}
  },
  "voice": {
    "provider": "vapi",
    "voiceId": "Elliot",
    "version": "2",
    "chunkPlan": {
      "enabled": true,
      "minCharacters": 30,
      "punctuationBoundaries": [".", "!", "?"]
    }
  },
  "stopSpeakingPlan": {
    "numWords": 2
  },
  "backgroundSpeechDenoisingPlan": {
    "smartDenoisingPlan": {"enabled": true}
  }
}
