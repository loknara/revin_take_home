#!/bin/sh
# Serve the backend from this Mac through a fixed ngrok domain, for the demo window.
#
#   ./scripts/serve-local
#
# Needs in .env: the usual backend settings plus NGROK_DOMAIN (your free static domain,
# e.g. something.ngrok-free.app). Keeps the Mac awake while running and restarts the
# server or tunnel if either exits. Stop with Ctrl-C.
#
# Limits, stated plainly: the Mac must stay powered, online and awake (plugged in, lid
# open). If it sleeps or loses Wi-Fi, calls hit Vapi's spoken failure message instead.
set -eu
cd "$(dirname "$0")/.."

if [ ! -f .env ]; then echo "Missing .env (copy .env.example)"; exit 1; fi
NGROK_DOMAIN=$(sed -n 's/^NGROK_DOMAIN=//p' .env | tail -1)
if [ -z "$NGROK_DOMAIN" ]; then echo "Set NGROK_DOMAIN in .env (dashboard.ngrok.com > Domains)"; exit 1; fi
PORT="${PORT:-8000}"
mkdir -p eval-results
LOG_DIR=eval-results/serve-local
mkdir -p "$LOG_DIR"

cleanup() {
    trap - INT TERM EXIT
    kill 0 2>/dev/null || true
}
trap cleanup INT TERM EXIT

# Keep the system, disk and network awake for as long as this script runs (AC power).
caffeinate -dimsu -w $$ &

(
    while true; do
        uv run --env-file .env uvicorn revin_take_home.app:create_app --factory \
            --host 127.0.0.1 --port "$PORT" >>"$LOG_DIR/backend.log" 2>&1 || true
        echo "$(date) backend exited; restarting" >>"$LOG_DIR/backend.log"
        sleep 2
    done
) &

(
    while true; do
        ngrok http "$PORT" --url "https://$NGROK_DOMAIN" --log stdout >>"$LOG_DIR/ngrok.log" 2>&1 || true
        echo "$(date) ngrok exited; restarting" >>"$LOG_DIR/ngrok.log"
        sleep 5
    done
) &

printf 'Waiting for https://%s/version ' "$NGROK_DOMAIN"
i=0
until curl -fsS "https://$NGROK_DOMAIN/version" >/dev/null 2>&1; do
    i=$((i + 1))
    if [ "$i" -gt 60 ]; then
        echo; echo "Not reachable after 2 minutes. See $LOG_DIR/backend.log and $LOG_DIR/ngrok.log"
        exit 1
    fi
    printf '.'
    sleep 2
done
echo
curl -fsS "https://$NGROK_DOMAIN/version"
echo
echo "Serving at https://$NGROK_DOMAIN (logs in $LOG_DIR). Point Vapi here with:"
echo "  uv run --env-file .env python -m revin_take_home.configure_vapi --apply --phone-id <PHONE_ID> --backend-url https://$NGROK_DOMAIN"
wait
