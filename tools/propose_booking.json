          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "title": "Search Id",
          "type": "string"
        },
        "slot_id": {
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "title": "Slot Id",
          "type": "string"
        }
      },
      "required": [
        "expected_revision",
        "search_id",
        "slot_id"
      ],
      "type": "object"
    }
  },
  "messages": [
    {
      "type": "request-start",
      "content": "",
      "blocking": false
