{
  "type": "function",
  "async": false,
  "function": {
    "name": "propose_booking",
    "description": "Create a short-lived offer (2 minutes) for one window from the latest search_slots result. Call it BEFORE you offer that window to the caller, then say the date and window in one sentence and ask if you should book it; END YOUR TURN. Requires confirmed address and callback and an eligible routine or priority job. Does not book.",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "expected_revision": {
          "minimum": 0,
          "title": "Expected Revision",
          "type": "integer"
        },
        "search_id": {
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "title": "Search Id",
          "type": "string"
        },
        "slot_id": {
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "title": "Slot Id",
          "type": "string"
        }
      },
      "required": [
        "expected_revision",
        "search_id",
        "slot_id"
      ],
      "type": "object"
    }
  },
  "messages": [
    {
      "type": "request-start",
      "content": "",
      "blocking": false
    },
    {
      "type": "request-response-delayed",
      "timingMilliseconds": 1500,
      "contents": [
        {
          "type": "text",
          "language": "en",
          "text": "I'm still checking that window."
        },
        {
          "type": "text",
          "language": "es",
          "text": "Sigo revisando ese horario."
        }
      ]
    }
  ]
}
