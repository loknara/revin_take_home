{
  "type": "function",
  "async": false,
  "function": {
    "name": "request_followup",
    "description": "Record a follow-up for this call when booking can't complete, membership needs verification, an existing booking needs a change, or the caller wants a person and no live transfer is available (reason=caller_requested, which also pages the dispatcher). A recorded result does NOT guarantee a callback time, transfer, or cancel an appointment. Never use it instead of emergency guidance.",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "expected_revision": {
          "minimum": 0,
          "title": "Expected Revision",
          "type": "integer"
        },
        "reason": {
          "enum": [
            "no_availability",
            "booking_problem",
            "priority",
            "membership_verification",
            "incomplete_intake",
            "booking_change",
            "caller_requested"
          ],
          "title": "Reason",
          "type": "string"
        },
        "caller_quote": {
          "maxLength": 1000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Caller Quote",
          "type": "string"
        }
      },
      "required": [
        "expected_revision",
        "reason",
        "caller_quote"
      ],
      "type": "object"
    }
  },
  "messages": [
    {
      "type": "request-start",
      "content": "",
      "blocking": false
    },
    {
      "type": "request-response-delayed",
      "timingMilliseconds": 3000,
      "contents": [
        {
          "type": "text",
          "language": "en",
          "text": "Thanks for bearing with me, I'm still working on it."
        },
        {
          "type": "text",
          "language": "es",
          "text": "Gracias por su paciencia, sigo trabajando en ello."
        }
      ]
    }
  ]
}
